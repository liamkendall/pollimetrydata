Package: pollimetrydata
Type: Package
Title: Fitted Models for Pollinator Body Size and Foraging Range
Version: 1.0.1
Authors@R: c(
    person("Liam", "Kendall", email = "liam.k.kendall@gmail.com",
           role = c("aut", "cre")),
    person("Ignasi", "Bartomeus", email = "nacho.bartomeus@gmail.com",
